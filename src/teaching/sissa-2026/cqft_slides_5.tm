    \\node[box] (bwd) at (8.6,-2.4) {Backward\\\\ representation:\\\\ energy $E$ by $b^{\\mathrm b}$,\\\\ boundary, $\\frac{C\\gamma^2}{q_\\ast}J$ (L6)};

